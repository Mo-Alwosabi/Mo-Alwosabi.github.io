---
import { t } from '../../utils/i18n';

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;
const isRtl = lang === 'ar';

const cards = [
  {
    title: t('values.card1Title', lang),
    text: t('values.card1Text', lang),
    delay: 100,
    repos: [
      { label: 'Basira-Cashier-AI', url: 'https://github.com/Mo-Alwosabi/Basira-Cashier-AI' },
      { label: 'Rased-Plate-AI', url: 'https://github.com/Mo-Alwosabi/Rased-Plate-AI' },
    ],
  },
  {
    title: t('values.card2Title', lang),
    text: t('values.card2Text', lang),
    delay: 200,
    repos: [
      { label: 'Local-RAG-Workstation', url: 'https://github.com/Mo-Alwosabi/Local-RAG-Workstation' },
    ],
  },
  {
    title: t('values.card3Title', lang),
    text: t('values.card3Text', lang),
    delay: 300,
    repos: [
      { label: 'Itqan-Interview-AI', url: 'https://github.com/Mo-Alwosabi/Itqan-Interview-AI' },
      { label: 'Mizan-Commerce-AI', url: 'https://github.com/Mo-Alwosabi/Mizan-Commerce-AI' },
      { label: 'Bayan-Multi-Search-AI', url: 'https://github.com/Mo-Alwosabi/Bayan-Multi-Search-AI' },
    ],
  },
];
---

<section id="about" class="py-16 md:py-24 bg-neutral-bg/75 dark:bg-neutral-dark/50 backdrop-blur-[2px]">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-12 text-center" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-secondary dark:text-white mb-4">{t('values.title', lang)}</h2>
      <p class="text-secondary/70 dark:text-white/70 max-w-2xl mx-auto">
        {t('values.subtitle', lang)}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {cards.map((card, index) => (
        <div
          class="group flex flex-col justify-between bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl p-8 shadow-sm hover:shadow-md transition-all duration-300 hover:bg-gradient-highlight dark:hover:bg-gradient-to-br dark:hover:from-primary/5 dark:hover:to-orange-500/5"
          data-aos="fade-up"
          data-aos-delay={card.delay}
        >
          <div>
            <div class="mb-6 text-primary">
              {index === 0 && (
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label={card.title}>
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              )}
              {index === 1 && (
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label={card.title}>
                  <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                  <path d="M3 5v14a9 3 0 0 0 18 0V5"></path>
                  <path d="M3 12a9 3 0 0 0 18 0"></path>
                </svg>
              )}
              {index === 2 && (
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label={card.title}>
                  <path d="M12 20v-6M9 20v-4M6 20v-2M15 20v-2M18 20v-4"></path>
                  <path d="m4 4 2.5 2.5M19.1 8l-7.2 7.2M15 12V4h-8"></path>
                </svg>
              )}
            </div>
            <h3 class="font-heading text-xl text-secondary dark:text-white mb-3 group-hover:text-primary transition-colors duration-300">{card.title}</h3>
            <p class="text-secondary/70 dark:text-white/70">
              {card.text}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-800 flex flex-wrap gap-2">
            {card.repos.map((repo) => (
              <a
                href={repo.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group/link inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-medium bg-primary/10 text-primary hover:bg-primary hover:text-white transition-colors duration-200"
              >
                <span>{repo.label}</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={`transition-transform duration-200 ${isRtl ? 'rotate-180 group-hover/link:-translate-x-0.5' : 'group-hover/link:translate-x-0.5'}`}
                  aria-hidden="true"
                >
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
