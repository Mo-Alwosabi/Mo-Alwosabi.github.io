---
import { t } from '../../utils/i18n';

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;
---

<section id="about" class="py-16 md:py-24 bg-neutral-bg/75 dark:bg-neutral-dark/50 backdrop-blur-[2px]">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-12 text-center" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-secondary dark:text-white mb-4">{t('values.title', lang)}</h2>
      <p class="text-secondary/70 dark:text-white/70 max-w-2xl mx-auto">
        {t('values.subtitle', lang)}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Computer Vision & Embedded AI -->
      <a
        href="https://github.com/Mo-Alwosabi/Basira-Cashier-AI"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex flex-col justify-between bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl p-8 shadow-sm hover:shadow-md transition-all duration-300 transform hover:scale-105 hover:bg-gradient-highlight dark:hover:bg-gradient-to-br dark:hover:from-primary/5 dark:hover:to-orange-500/5"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <div>
          <div class="mb-6 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role="img" aria-labelledby="visionIconTitle">
              <title id="visionIconTitle">{t('values.card1Title', lang)}</title>
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
          <h3 class="font-heading text-xl text-secondary dark:text-white mb-3 group-hover:text-primary transition-colors duration-300">{t('values.card1Title', lang)}</h3>
          <p class="text-secondary/70 dark:text-white/70">
            {t('values.card1Text', lang)}
          </p>
        </div>
        <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-primary">
          {t('values.viewRepo', lang)} →
        </span>
      </a>

      <!-- Local RAG & LLM Systems -->
      <a
        href="https://github.com/Mo-Alwosabi/Local-RAG-Workstation"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex flex-col justify-between bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl p-8 shadow-sm hover:shadow-md transition-all duration-300 transform hover:scale-105 hover:bg-gradient-highlight dark:hover:bg-gradient-to-br dark:hover:from-primary/5 dark:hover:to-orange-500/5"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <div>
          <div class="mb-6 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role="img" aria-labelledby="ragIconTitle">
              <title id="ragIconTitle">{t('values.card2Title', lang)}</title>
              <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
              <path d="M3 5v14a9 3 0 0 0 18 0V5"></path>
              <path d="M3 12a9 3 0 0 0 18 0"></path>
            </svg>
          </div>
          <h3 class="font-heading text-xl text-secondary dark:text-white mb-3 group-hover:text-primary transition-colors duration-300">{t('values.card2Title', lang)}</h3>
          <p class="text-secondary/70 dark:text-white/70">
            {t('values.card2Text', lang)}
          </p>
        </div>
        <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-primary">
          {t('values.viewRepo', lang)} →
        </span>
      </a>

      <!-- Multi-Agent AI & Full-Stack -->
      <a
        href="https://github.com/Mo-Alwosabi/Itqan-Interview-AI"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex flex-col justify-between bg-white dark:bg-neutral-dark border border-gray-100 dark:border-gray-800 rounded-xl p-8 shadow-sm hover:shadow-md transition-all duration-300 transform hover:scale-105 hover:bg-gradient-highlight dark:hover:bg-gradient-to-br dark:hover:from-primary/5 dark:hover:to-orange-500/5"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <div>
          <div class="mb-6 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role="img" aria-labelledby="agentsIconTitle">
              <title id="agentsIconTitle">{t('values.card3Title', lang)}</title>
              <path d="M12 20v-6M9 20v-4M6 20v-2M15 20v-2M18 20v-4"></path>
              <path d="m4 4 2.5 2.5M19.1 8l-7.2 7.2M15 12V4h-8"></path>
            </svg>
          </div>
          <h3 class="font-heading text-xl text-secondary dark:text-white mb-3 group-hover:text-primary transition-colors duration-300">{t('values.card3Title', lang)}</h3>
          <p class="text-secondary/70 dark:text-white/70">
            {t('values.card3Text', lang)}
          </p>
        </div>
        <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-primary">
          {t('values.viewRepo', lang)} →
        </span>
      </a>
    </div>
  </div>
</section>
