---
import { t } from '../../utils/i18n';

interface Props {
  lang: string | undefined;
}

const { lang } = Astro.props;
const isRtl = lang === 'ar';

const timelineItems = ["item1", "item2", "item3", "item4"];
---

<section class="py-16 md:py-24 bg-neutral-bg/75 dark:bg-neutral-dark/70 backdrop-blur-[2px]">
  <div class="max-w-container mx-auto px-6">
    <div class="mb-12" data-aos="fade-up">
      <h2 class="font-heading text-h2 text-secondary dark:text-white mb-4">{t('timeline.title', lang)}</h2>
      <p class="text-secondary/70 dark:text-white/70 max-w-2xl">
        {t('timeline.subtitle', lang)}
      </p>
    </div>

    <div id="timeline-container" class="relative">
      <!-- Timeline line -->
      <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-gray-200 dark:bg-gray-700 transform -translate-x-1/2"></div>
      <div class={`md:hidden absolute ${isRtl ? 'right-2' : 'left-2'} top-0 bottom-0 w-px bg-gray-200 dark:bg-gray-700`}></div>

      <div class="space-y-12">
        {timelineItems.map((item, index) => (
          <div
            class={`relative flex flex-col md:flex-row gap-6 md:gap-0 ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`}
            data-aos={index % 2 === 0 ? "fade-left" : "fade-right"}
          >
            {/* Timeline dot */}
            <div class={`timeline-dot absolute ${isRtl ? 'right-0 md:right-auto' : 'left-0'} md:left-1/2 top-1 w-5 h-5 rounded-full bg-primary border-4 border-white dark:border-neutral-dark md:-translate-x-1/2`}></div>

            <!-- Content -->
            <div class={`md:w-1/2 ${isRtl ? 'pr-10' : 'pl-10'} md:px-12`}>
              <h3 class="font-heading text-xl text-secondary dark:text-white mb-2">{t("timeline." + item + "Title", lang)}</h3>
              <p class="text-secondary/70 dark:text-white/70 leading-relaxed">{t("timeline." + item + "Description", lang)}</p>
            </div>

            <div class="md:w-1/2">
              <!-- Empty div to create the layout on alternating sides -->
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const timelineDots = document.querySelectorAll('.timeline-dot');

    gsap.from(timelineDots, {
      scrollTrigger: {
        trigger: '#timeline-container',
        start: 'top 80%',
      },
      scale: 0,
      opacity: 0,
      duration: 0.5,
      stagger: 0.2,
      ease: 'back.out(1.7)'
    });
  });
</script>
