---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../utils/i18n';
import { email, phone, address_line_1, address_line_2 } from '../../utils/me';

const lang = 'ar';
const pageTitle = t('footer.imprint', lang) + " | " + t('site.title', lang);
const pageDescription = t('footer.imprint', lang) + " - " + t('site.title', lang);
---

<Layout title={pageTitle} description={pageDescription} lang={lang}>
  <section class="py-16 md:py-24">
    <div class="max-w-container mx-auto px-6">
      <header class="mb-12 text-center">
        <h1 class="font-heading text-h1 text-secondary dark:text-white">{t('footer.imprint', lang)}</h1>
      </header>

      <article class="prose dark:prose-invert max-w-none mx-auto bg-white dark:bg-neutral-dark p-6 md:p-8 rounded-lg shadow">
        <p><strong>المعلومات التعريفية لصاحب الموقع:</strong></p>
        <p>
          محمد أمين محمد عزي الوصابي<br />
          {address_line_1}<br />
          {address_line_2}
        </p>

        <h2>التواصل:</h2>
        <p>
          الهاتف: {phone}<br />
          البريد الإلكتروني: {email}
        </p>

        <h2>إخلاء المسؤولية</h2>
        <p>هذا الموقع هو ملف تعريفي شخصي (Portfolio) يعرض المهارات والمشاريع والخبرات الأكاديمية والمهنية في مجال الذكاء الاصطناعي وتطوير البرمجيات.</p>
      </article>
    </div>
  </section>
</Layout>
